<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>ScreenGuard.App</RootNamespace>
    <AssemblyName>ScreenGuard</AssemblyName>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <!-- SkiaSharp for image processing (cross-platform, no System.Drawing dependency) -->
    <PackageReference Include="SkiaSharp" Version="2.88.8" />
    <PackageReference Include="SkiaSharp.NativeAssets.macOS" Version="2.88.8" />
    <PackageReference Include="SkiaSharp.NativeAssets.Win32" Version="2.88.8" />

    <!-- Tesseract OCR for text extraction from screenshots -->
    <PackageReference Include="Tesseract" Version="5.2.0" />

    <!-- ONNX Runtime for on-device person-name recognition (NER) -->
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.20.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- Copy native library to output directory -->
    <None Include="libscreencapture.dylib"
          CopyToOutputDirectory="PreserveNewest"
          Condition="Exists('libscreencapture.dylib')" />

    <!-- Copy NER model (downloaded by scripts/download_models.sh) to output -->
    <None Include="../models/**"
          CopyToOutputDirectory="PreserveNewest"
          LinkBase="models" />

    <!-- Copy tessdata directory to output -->
    <None Include="../tessdata/**"
          CopyToOutputDirectory="PreserveNewest"
          LinkBase="tessdata" />
  </ItemGroup>

</Project>
